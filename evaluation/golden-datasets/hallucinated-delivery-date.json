{
 "scenario": "hallucinated-delivery-date",
 "description": "The response model promises a delivery date or ETA nobody can know: rejected. Runs in-process.",
 "cases": [
  {
   "id": "hdd-promises-a-date",
   "mode": "component",
   "description": "Completed recovery; the model promises arrival on Friday.",
   "setup": {
    "order": {
     "customer": "CUST-1001",
     "amount": 129.99,
     "product": "PRD-100",
     "shipment": {
      "status": "LOST",
      "delay_days": 5
     }
    },
    "approval": "APPROVE"
   },
   "input": {
    "customerId": "CUST-1001",
    "message": "My order {order} has been delayed by five days. Cancel the order, refund me, and suggest a cheaper replacement.",
    "actor": "service"
   },
   "expected_intent": "DELAYED_ORDER_RECOVERY",
   "expected_tools": {
    "must_call": [],
    "must_not_call": []
   },
   "expected_approval_required": null,
   "expected_final_status": "COMPLETED",
   "expected_guardrail_behavior": {
    "audit_events_present": [],
    "audit_events_absent": [],
    "kafka_topics_present": [],
    "message_includes": [],
    "message_includes_any": [],
    "message_excludes": [
     "Friday",
     "arrive"
    ],
    "message_matches": [
     "RF-[A-Z0-9]{10}"
    ],
    "message_must_not_match": [],
    "errors_include": [
     "GUARDRAIL_RESPONSE_REJECTED"
    ]
   },
   "expected_rag_confidence": null,
   "expected_citations": [],
   "script": {
    "response": [
     {
      "message": "Your refund RF-AAAAAAAAAA is initiated and your replacement ORD-BBBBBBBBBB will arrive on Friday."
     }
    ]
   }
  },
