    ],
    "must_not_call": [
     "initiate_refund",
     "reserve_inventory",
     "create_replacement_order",
     "create_approval_request"
    ]
   },
   "expected_approval_required": false,
   "expected_final_status": "ESCALATED",
   "expected_guardrail_behavior": {
    "audit_events_present": [
     "SHIPMENT_UNVERIFIED"
    ],
    "audit_events_absent": [],
    "kafka_topics_present": [],
    "message_includes": [],
    "message_includes_any": [
     "verify",
     "review"
    ],
    "message_excludes": [],
    "message_matches": [],
    "message_must_not_match": [
     "(arrive|deliver)[^.]*(on|by|within) "
    ],
    "errors_include": []
   },
   "expected_rag_confidence": null,
   "expected_citations": [],
   "expected_state": {
    "refund_rows": 0
   }
  }
 ]
}
