{
 "scenario": "missing-shipment-data",
 "description": "Shipment data is missing or the carrier is down: never invent a status; escalate and say it could not be verified. The carrier case needs PLATFORM_FAULTS_ENABLED=true.",
 "cases": [
  {
   "id": "msd-no-shipment-row",
   "mode": "live",
   "description": "No shipment record exists for the order.",
   "setup": {
    "order": {
     "customer": "CUST-1001",
     "amount": 129.99,
     "product": "PRD-100",
     "shipment": null
    }
   },
   "input": {
    "customerId": "CUST-1001",
    "message": "My order {order} has been delayed by five days. Cancel the order, refund me, and suggest a cheaper replacement.",
    "actor": "service"
   },
   "expected_intent": "DELAYED_ORDER_RECOVERY",
   "expected_tools": {
    "must_call": [
