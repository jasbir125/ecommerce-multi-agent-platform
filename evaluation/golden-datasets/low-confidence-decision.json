{
 "scenario": "low-confidence-decision",
 "description": "Weak or contradicting evidence must stop the workflow before a refund is even proposed.",
 "cases": [
  {
   "id": "lcd-policy-says-no",
   "mode": "live",
   "description": "Only one day late: the deterministic policy check says no refund.",
   "setup": {
    "order": {
     "customer": "CUST-1001",
     "amount": 129.99,
     "product": "PRD-100",
     "shipment": {
      "status": "DELAYED",
      "delay_days": 1
     }
    }
   },
   "input": {
    "customerId": "CUST-1001",
    "message": "My order {order} has been delayed by five days. Cancel the order, refund me, and suggest a cheaper replacement.",
    "actor": "service"
   },
   "expected_intent": "DELAYED_ORDER_RECOVERY",
   "expected_tools": {
    "must_call": [],
    "must_not_call": [
     "initiate_refund",
     "reserve_inventory",
     "create_replacement_order",
     "create_approval_request"
    ]
   },
   "expected_approval_required": false,
   "expected_final_status": "ESCALATED",
   "expected_guardrail_behavior": {
    "audit_events_present": [],
    "audit_events_absent": [],
    "kafka_topics_present": [],
    "message_includes": [],
    "message_includes_any": [],
    "message_excludes": [],
    "message_matches": [],
    "message_must_not_match": [],
    "errors_include": [
     "DECISION_ESCALATED"
    ]
   },
   "expected_rag_confidence": {
    "min": 0.4,
    "max": 1.0,
    "grounded": true
   },
   "expected_citations": [],
   "expected_state": {
    "refund_rows": 0
   }
  },
  {
   "id": "lcd-weak-evidence",
   "mode": "component",
   "description": "Retrieval confidence is below the threshold.",
   "setup": {
    "order": {
     "customer": "CUST-1001",
     "amount": 129.99,
     "product": "PRD-100",
     "shipment": {
      "status": "LOST",
      "delay_days": 5
     }
    },
    "approval": "APPROVE"
   },
   "input": {
    "customerId": "CUST-1001",
    "message": "My order {order} has been delayed by five days. Cancel the order, refund me, and suggest a cheaper replacement.",
    "actor": "service"
   },
   "expected_intent": "DELAYED_ORDER_RECOVERY",
   "expected_tools": {
    "must_call": [],
    "must_not_call": [
     "initiate_refund",
     "reserve_inventory",
     "create_replacement_order",
     "create_approval_request"
    ]
   },
   "expected_approval_required": false,
   "expected_final_status": "ESCALATED",
   "expected_guardrail_behavior": {
    "audit_events_present": [],
    "audit_events_absent": [],
    "kafka_topics_present": [],
    "message_includes": [],
    "message_includes_any": [],
    "message_excludes": [],
    "message_matches": [],
    "message_must_not_match": [],
    "errors_include": [
     "DECISION_ESCALATED"
    ]
   },
   "expected_rag_confidence": {
    "min": 0.0,
    "max": 0.35,
    "grounded": false
   },
   "expected_citations": [],
   "script": {
    "rag": {
     "confidence": 0.2,
     "insufficient": true,
     "sources": []
    }
   }
  }
 ]
}