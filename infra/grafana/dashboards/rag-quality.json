  {
   "id": 3,
   "type": "stat",
   "title": "Answered from evidence (1h)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 0,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "expr": "1 - (sum(increase(rag_answers_total{outcome=~\"insufficient|unavailable\"}[1h])) or vector(0)) / clamp_min(sum(increase(rag_answers_total[1h])), 1)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.7
       },
       {
        "color": "green",
        "value": 0.9
       }
      ]
     },
     "noValue": "no data yet"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   }
  },
