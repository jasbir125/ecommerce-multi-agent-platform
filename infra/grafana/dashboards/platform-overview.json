   "targets": [
    {
     "refId": "A",
     "expr": "(sum(increase(agent_workflow_runs_total{status=\"COMPLETED\"}[1h])) or vector(0)) / clamp_min(sum(increase(agent_workflow_runs_total[1h])), 1)",
