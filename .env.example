# =============================================================================
# Copy to .env and replace placeholders:  cp .env.example .env
# Never commit .env.
# =============================================================================

# --- LLM providers ------------------------------------------------------------
OPENAI_API_KEY=replace-with-openai-key
ANTHROPIC_API_KEY=replace-with-claude-key
MODEL_PROVIDER=anthropic              # anthropic | openai | bedrock (bedrock uses AWS credentials / the task role, no key)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Spring Boot service URLs (host-run defaults; ports match docker-compose) --
ORDER_SERVICE_URL=http://localhost:8081
SHIPMENT_SERVICE_URL=http://localhost:8082
PAYMENT_SERVICE_URL=http://localhost:8083
INVENTORY_SERVICE_URL=http://localhost:8084
APPROVAL_SERVICE_URL=http://localhost:8085
POLICY_SERVICE_URL=http://localhost:8086
AUDIT_SERVICE_URL=http://localhost:8087
WORKFLOW_SERVICE_URL=http://localhost:8088
NOTIFICATION_SERVICE_URL=http://localhost:8089

# --- FastMCP servers -----------------------------------------------------------
ECOMMERCE_MCP_URL=http://localhost:8090/mcp
POLICY_MCP_URL=http://localhost:8091/mcp
MCP_SERVICE_TOKEN=local-demo-token

# --- Agent host / Streamlit ----------------------------------------------------
AGENT_HOST_URL=http://localhost:8092
STREAMLIT_API_BASE_URL=http://localhost:8088
STREAMLIT_APPROVAL_API_BASE_URL=http://localhost:8085

# --- Data stores ---------------------------------------------------------------
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_local_pw
POSTGRESQL_URL=jdbc:postgresql://localhost:5432/ecommerce
REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Observability -------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- AWS Bedrock (placeholders) -------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-if-using-aws
AWS_SECRET_ACCESS_KEY=replace-if-using-aws
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-v2:0
BEDROCK_KNOWLEDGE_BASE_ID=replace-if-using-aws
BEDROCK_GUARDRAIL_ID=replace-if-using-aws
BEDROCK_GUARDRAIL_VERSION=DRAFT

# --- Per-agent model routing (see recommended_model) ---------------------------
# Start with one family (Sonnet) for every agent; switch individual agents to a
# cheaper/stronger model once the workflow works.
MODEL_SUPERVISOR=claude-sonnet-5-5
MODEL_ORDER_AGENT=claude-sonnet-5-5       # later: claude-haiku-5-5
MODEL_SHIPMENT_AGENT=claude-sonnet-5-5    # later: claude-haiku-5-5
MODEL_POLICY_AGENT=claude-sonnet-5-5
MODEL_PRODUCT_AGENT=claude-sonnet-5-5
MODEL_RISK_AGENT=claude-sonnet-5-5        # deterministic rules should dominate
MODEL_DECISION_AGENT=claude-sonnet-5-5
MODEL_RESPONSE_AGENT=claude-sonnet-5-5    # later: claude-haiku-5-5
MODEL_COMPLEX_DISPUTE=claude-opus-5-5     # only for difficult, high-value cases
MODEL_EVALUATION=claude-sonnet-5-5        # later: claude-haiku-5-5

# Embeddings for policy RAG: openai | hash (offline fallback)
POLICY_EMBEDDING_PROVIDER=hash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG (policy retrieval and grounded answers) ------------------------------
RAG_USE_REWRITE=true                 # LLM rewrites questions into policy vocabulary
RAG_USE_LLM_RERANK=true              # LLM listwise rerank of the candidate passages
RAG_MAX_CONTEXT_TOKENS=700           # evidence budget sent to the generator
RAG_TOP_K=4
RAG_MIN_SUPPORT=0.5                  # share of a statement's content words that must appear in its cited passages
RAG_ANSWER_CACHE_TTL=900
POLICY_READ_DATASOURCE_URL=          # optional read replica (JDBC URL) for retrieval queries

# Host port for Postgres (change if a local Postgres already uses 5432)
POSTGRES_HOST_PORT=5432


# --- Logging (see docs/logging.md) ---------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text                  # text | json
LOG_PAYLOAD_CHARS=1500           # max characters of any logged body/argument/result
LOG_LLM_CONTENT=true             # false = do not log prompts and model answers
PLATFORM_LOGGING_BODIES=true     # Spring services: log request/response bodies
PLATFORM_LOGGING_MAX_BODY_CHARS=2000
